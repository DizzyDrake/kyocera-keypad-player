+# SPDX-License-Identifier: Apache-2.0
+# Source compile without an installable deliverable: the runner's auto-created
+# debug signing key is NOT necessarily compatible with the owner's installed APK.
+name: Dumbplayer DEV13 compile check (no APK artifact)
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  android-compile-only:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: android-actions/setup-android@v3
+        with:
+          packages: 'platform-tools'
+      - name: Install Android SDK platform
+        run: sdkmanager 'platforms;android-33' 'build-tools;33.0.2'
+      - uses: gradle/actions/setup-gradle@v4
+        with:
+          gradle-version: '7.6.4'
+      - name: Offline feature regression
+        run: |
+          bash tests/run_bluetooth_volume_seek_smoke.sh
+          python3 tests/test_stale_import_source.py
+      - name: Android Gradle compilation (debug, NOT an installable update)
+        run: gradle --no-daemon :app:assembleDebug
+      - name: Explain missing install artifact
+        run: echo 'Compile succeeded. This workflow intentionally does not publish an APK because the debug signer may differ from the owner-installed DEV12 APK. Run the signed-update workflow after providing the ORIGINAL compatible signing key.'
